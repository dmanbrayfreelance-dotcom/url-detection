{
  "manifest_version": 3,
  "name": "TrackPhish Enhanced | Zero-Visit URL Shield",
  "version": "1.0.0",
  "description": "Zero-live-visit phishing URL detection with token attention explainability heatmaps (IEEE TIFS 2025).",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://url-detection-4faf.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan URL with TrackPhish Enhanced"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
